<?xml version="1.0" encoding="UTF-8"?>
<f:template xmlns:f='http:/jsf.exadel.com/template'
            xmlns:u='http:/jsf.exadel.com/template/util'
            xmlns="http://www.w3.org/1999/xhtml"
            xmlns:jsp=" http://ajax4jsf.org/cdk/jsp"
            component="org.richfaces.component.UISuggestionBox">

    <div class="rich-sb-ext-decor-1">
         <div>
		 	<f:attribute name="class">
		    		<f:verbatim value="rich-sb-ext-decor-2 "/>
		    		<f:call name="getCssExtDecorClassStyle"/>
				</f:attribute>
				<f:call name="insertCssExtDecorRules" />
		     <table border="0" cellpadding="0" cellspacing="1" class="rich-sb-ext-decor-3">

                <tbody>
                    <tr>
                        <td>
                            <div>
								<f:attribute name="class">
								           		<f:verbatim value="_suggestion_size_ rich-sb-overflow "/>
								           		<f:call name="getCssSbOverflowClassStyle"/>
								       		</f:attribute>
								<f:call name="insertCssSbOverflowRules" />

                                <table width="100%" >
                                    <f:attribute name="id">
                                        <f:call name="getContentId"/>
                                    </f:attribute>
                                    <f:attribute name="border">
                                        <f:call name="getBorder"/>
                                    </f:attribute>
                                    <f:call name="utils.encodePassThruWithExclusions">
                                        <f:parameter value="onclick,onselect,width,height,rows,border"/>
                                    </f:call>
                                    <tbody>
                                        <tr class="rich-sb-display-none"><td> </td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

	<div>
		<f:attribute name="class">
       		<f:verbatim value="rich-sb-shadow "/>
       		<f:call name="getCssSbShadowClassStyle"/>
   		</f:attribute>
		<style type="text/css">
			<f:attribute name="nonce">
	       		<f:call name="getNonce"/>
	   		</f:attribute>
			.#{cssId}-sb-shadow-style { <f:call name="opacityStyle"/> <f:call name="shadowDepth"/> }
			</style>
	</div>

</f:template>
