<?xml version="1.0" encoding="UTF-8"?>
<f:root xmlns:f="http://ajax4jsf.org/cdk/template"
	xmlns:c=" http://java.sun.com/jsf/core"
	xmlns:ui=" http://ajax4jsf.org/cdk/ui"
	xmlns:u=" http://ajax4jsf.org/cdk/u"
	xmlns:x=" http://ajax4jsf.org/cdk/x"
	xmlns:h="http://jsf.exadel.com/header"
	baseclass="org.richfaces.renderkit.TabHeaderRendererBase"
	class="org.richfaces.renderkit.html.TabHeaderRenderer"
	component="org.richfaces.component.UITab">

	<f:clientid var="clientId" />

	<f:resource name="images/spacer.gif" var="spacer" />
	
	<jsp:scriptlet>
	<![CDATA[ 
			variables.setVariable("cspValue", getUtils().getCspNonceValue(context));
			variables.setVariable("cssId", getUtils().getCssId(clientId));
	]]>
	</jsp:scriptlet>
	<style type="text/css" nonce="#{cspValue}">
		.#{cssId}-tab-cell-td-style { height: 100%; vertical-align: bottom; }
		.#{cssId}-tab-side-border-img-style { border:0; }
		.#{cssId}-tab-td-side-cell-style { #{this:encodeTabLabelWidth(context, component)}; }
		.#{cssId}-tab-td-side-cell-table-style { height: 100%; width: 100%; }
		.#{cssId}-tab-header-spacer-img-style { #{this:encodeHeaderSpacing(context, component)};border:0; }
	</style>
	<td id="#{clientId}_cell">
		<f:call name="encodeCellClasses" />

		<table id="#{clientId}_shifted" border="0" cellpadding="0" cellspacing="0">
			<f:call name="encodeTabLabel" />
			
			<style type="text/css" nonce="#{cspValue}">
				<f:call name="encodeTabLabelClass" />
			</style>
			<tr>
				<td class="rich-tabhdr-side-border"><img src="#{spacer}" width="1" height="1" alt="" class="#{cssId}-tab-side-border-img-style" /></td>
				<td class="rich-tabhdr-side-cell #{cssId}-tab-td-side-cell-style">
					<table class="#{cssId}-tab-td-side-cell-table-style" border="0" cellpadding="0" cellspacing="0" >
						<tr>
							<td id="#{clientId}_lbl" >
								<f:call name="writeLabel" />
								<script type="text/javascript" nonce="#{cspValue}">
									jQuery(document).ready(function() {
										 #{this:getLabelEventsHandler(context, component)}
									 }); 
								</script>
							</td>
						</tr>
					</table>
				</td>
				<td class="rich-tabhdr-side-border"><img src="#{spacer}" width="1" height="1" alt="" class="#{cssId}-tab-side-border-img-style" /></td>
			</tr>
		</table>
		<script type="text/javascript" nonce="#{cspValue}">
			jQuery(document).ready(function() {
				 jQuery("table[id$='#{clientId}_shifted']").click(function(event) {
					 #{this:getOnClickEventHandler(context, component)}
				});
			 }); 
		</script>
	</td>
	<td><img src="#{spacer}" height="1" alt="" class="#{cssId}-tab-header-spacer-img-style"/></td>

</f:root>

