<?xml version="1.0" encoding="UTF-8"?>
<f:root 
	xmlns:f="http://ajax4jsf.org/cdk/template" 
	xmlns:c=" http://java.sun.com/jsf/core" 
	xmlns:ui=" http://ajax4jsf.org/cdk/ui"
	xmlns:u=" http://ajax4jsf.org/cdk/u"
	xmlns:x=" http://ajax4jsf.org/cdk/x"
	baseclass="org.richfaces.renderkit.InputNumberSpinnerBaseRenderer"
	class="org.richfaces.renderkit.html.InputNumberSpinnerRenderer"
	component="org.richfaces.component.UIInputNumberSpinner" 
	>
	<f:clientid var="clientId"/>
    
    <f:resource name="org.richfaces.renderkit.html.images.SpinnerButtonUp"
		var="up_arrow" />
    
    <f:resource	name="org.richfaces.renderkit.html.images.SpinnerButtonDown"
		var="down_arrow" />
    
	<h:scripts>new org.ajax4jsf.javascript.PrototypeScript(),script/SpinnerScript.js,/org/richfaces/renderkit/html/scripts/browser_info.js</h:scripts>
    <h:styles>css/spinner.xcss</h:styles>
	<jsp:scriptlet>
	<![CDATA[ 
			variables.setVariable("cspValue", getUtils().getCspNonceValue(context));
			variables.setVariable("cssId", getUtils().getCssId(clientId));
	]]>
	</jsp:scriptlet>
	 <style type="text/css" nonce="#{cspValue}">
		.#{cssId}-spinner-style { #{component.attributes['style']} }
		.#{cssId}-spinner-td-edit-style { width:1%; }
		.#{cssId}-spinner-input-style { #{component.inputStyle} }
		.#{cssId}-spinner-td-for-style { width:1%; }
		.#{cssId}-spinner-input-border-zero-style { border:0; }
	</style>
	<script type="text/javascript" nonce="#{cspValue}">
		#{this:getTableEventHandlersScript(context,component)}
	</script>
	<table width="2%" class="rich-spinner-c #{component.attributes['styleClass']} #{cssId}-spinner-style" id="#{clientId}" cellspacing="0" cellpadding="0" border="0" >
	<tbody>
	  	<tr>
			<td class="rich-spinner-input-container #{cssId}-spinner-td-edit-style" id="#{clientId}Edit">
			<jsp:scriptlet><![CDATA[
			    String autocomplete = "";
               	boolean disableBrowserAutoComplete = getUtils().isBooleanAttribute(component, "disableBrowserAutoComplete");
			    if (disableBrowserAutoComplete)
			    {
			    	autocomplete = "off";
			    }
			    variables.setVariable("autocomplete", autocomplete);
			]]></jsp:scriptlet>
			
				<input id="#{clientId}Input"
					class="rich-spinner-input #{component.attributes['inputClass']} #{cssId}-spinner-input-style" 
					type="text" 
					size="#{component.attributes['inputSize']}" 
					name="#{clientId}" 
					value="#{this:getInputValue(context, component)}" 
					accesskey="#{component.attributes['accesskey']}" 
					tabindex="#{component.attributes['tabindex']}"
					autocomplete='#{autocomplete}'
					/>
					<script type="text/javascript" nonce="#{cspValue}">
						#{this:getInputEventHandlersScript(context,component)}
					</script>
			</td>	
			<td id="#{clientId}For" class="rich-spinner-buttons #{cssId}-spinner-td-for-style">
				<table id="#{clientId}Buttons" border="0" cellspacing="0" cellpadding="0">
					<tbody>
						<tr>
							<td>								
								<jsp:scriptlet><![CDATA[
				                	boolean disabled = ((Boolean) component.getAttributes().get("disabled")).booleanValue();
				                	if (! disabled) {
                				]]></jsp:scriptlet>
                					<input id="#{clientId}BtnUp"
                						type="image" 
                						src="#{up_arrow}" 
                						class="rich-spinner-btn rich-spinner-button #{cssId}-spinner-input-border-zero-style" 
										tabindex="#{component.attributes['tabindex']}" />
										<script type="text/javascript" nonce="#{cspValue}">
											jQuery(document).ready(function() {
												jQuery("input[id$='#{clientId}BtnUp']").click(function() {
													return false;
										 		});	
												
												jQuery("input[id$='#{clientId}BtnUp']").mousedown(function() {
													this.className='rich-spinner-btn-press rich-spinner-button';
										 		});	
												
												jQuery("input[id$='#{clientId}BtnUp']").mouseup(function() {
													this.className='rich-spinner-btn rich-spinner-button';
										 		});	
												
												jQuery("input[id$='#{clientId}BtnUp']").mouseout(function() {
													this.className='rich-spinner-btn rich-spinner-button';
										 		});
			                				});
                						</script>
								<jsp:scriptlet><![CDATA[
				                	} else {
                				]]></jsp:scriptlet>
                					<input id="#{clientId}BtnUp"
                						type="image" 
                						src="#{up_arrow}" 
                						class="rich-spinner-btn rich-spinner-button #{cssId}-spinner-input-border-zero-style" 
                						tabindex="#{component.attributes['tabindex']}" /> 
                						<script type="text/javascript" nonce="#{cspValue}">
											jQuery(document).ready(function() {
													jQuery("input[id$='#{clientId}BtnUp']").click(function() {
														return false;
											 		});	
			                				});
                						</script>
                				<jsp:scriptlet><![CDATA[
				                	}
                				]]></jsp:scriptlet>
							</td>
						</tr>
						<tr>
							<td>								
								<jsp:scriptlet><![CDATA[				                	
				                	if (! disabled) {
                				]]></jsp:scriptlet>
                					<input type="image" src="#{down_arrow}" class="rich-spinner-btn rich-spinner-button #{cssId}-spinner-input-border-zero-style" id="#{clientId}BtnDown" />
									<script type="text/javascript" nonce="#{cspValue}">
										jQuery(document).ready(function() {
											jQuery("input[id$='#{clientId}BtnDown']").click(function() {
												return false;
									 		});
											
											jQuery("input[id$='#{clientId}BtnDown']").mousedown(function() {
												this.className='rich-spinner-btn-press rich-spinner-button';
									 		});	
											
											jQuery("input[id$='#{clientId}BtnDown']").mouseup(function() {
												this.className='rich-spinner-btn rich-spinner-button';
									 		});	
											
											jQuery("input[id$='#{clientId}BtnDown']").mouseout(function() {
												this.className='rich-spinner-btn rich-spinner-button';
									 		});	
	            						});
                					</script>
								<jsp:scriptlet><![CDATA[
				                	} else {
                				]]></jsp:scriptlet>
                					<input type="image" src="#{down_arrow}" class="rich-spinner-btn rich-spinner-button #{cssId}-spinner-input-border-zero-style" id="#{clientId}BtnDown" />
                					<script type="text/javascript" nonce="#{cspValue}">
                						jQuery(document).ready(function() {
                							jQuery("input[id$='#{clientId}BtnDown']").click(function() {
												return false;
									 		});
                						});
                					</script>
                				<jsp:scriptlet><![CDATA[
				                	}
                				]]></jsp:scriptlet>
							</td>
						</tr>
					</tbody>
				</table>
				<c:scriptObject var="options">
					<c:scriptOption attributes="cycled, enableManualInput" defaultValue="true"/>
					<c:scriptOption attributes="disabled, required, clientErrorMessage" />
					<c:scriptOption name="min" value="#{component.attributes['minValue']}" defaultValue="0" />
					<c:scriptOption name="max" value="#{component.attributes['maxValue']}" defaultValue="100" />
					<c:scriptOption name="delta" value="#{component.attributes['step']}" defaultValue="1" />
					<c:scriptOption name="onup"  value="#{component.attributes['onupclick']}" />
					<c:scriptOption name="ondown"  value="#{component.attributes['ondownclick']}" />
					<c:scriptOption name="onerr"  value="#{component.attributes['onerror']}" />
				</c:scriptObject>
				<script type="text/javascript" nonce="#{cspValue}">
					new Richfaces.Spinner(
					"#{clientId}"
					<c:if test="#{not empty options}">
					, <f:writeAsScript value="#{options}" />
					</c:if> 
					);
				</script>
			</td>
		</tr>
	</tbody>
</table>
</f:root>
