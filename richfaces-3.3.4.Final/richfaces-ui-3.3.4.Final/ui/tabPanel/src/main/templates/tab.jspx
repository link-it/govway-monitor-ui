<?xml version="1.0" encoding="UTF-8"?>
<f:root 
	xmlns:f="http://ajax4jsf.org/cdk/template" 
	xmlns:c=" http://java.sun.com/jsf/core" 
	xmlns:ui=" http://ajax4jsf.org/cdk/ui"
	xmlns:u=" http://ajax4jsf.org/cdk/u"
	xmlns:x=" http://ajax4jsf.org/cdk/x"
	xmlns:vcp="http://ajax4jsf.org/cdk/vcp"
	class="org.richfaces.renderkit.html.TabRenderer"
	baseclass="org.richfaces.renderkit.TabRendererBase"
	component="org.richfaces.component.UITab" 
	>
	
	<f:clientid var="clientId"/>
	<jsp:scriptlet>
	<![CDATA[ 
			variables.setVariable("cspValue", getUtils().getCspNonceValue(context));
			variables.setVariable("cssId", getUtils().getCssId(clientId));
	]]>
	</jsp:scriptlet>
	<style type="text/css" nonce="#{cspValue}">
		.#{cssId}-tab-td-style { #{this:getTabDisplay(context, component)}; height:100%; }
		.#{cssId}-tab-td-content-style { #{component.pane.attributes['contentStyle']}; #{component.attributes['style']}; }
	</style>

	<td id="#{clientId}" class="#{cssId}-tab-td-style">

		<table border="0" cellpadding="10" cellspacing="0" width="100%" class="rich-tabpanel-content-position">
			<tr>
				<td class="rich-tabpanel-content #{component.pane.attributes['contentClass']} #{component.attributes['styleClass']} #{cssId}-tab-td-content-style" 
					x:passThruWithExclusions="class,style,styleClass,id"
					>
					<vcp:body />
				</td>
			</tr>
		</table>
	</td>
</f:root>
